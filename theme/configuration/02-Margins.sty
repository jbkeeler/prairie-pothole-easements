%%% Margins %%%
\usepackage{geometry}

\geometry{
    paper=letterpaper,
    top=1in,
    bottom=1in,
    left=0.75in,
    right=0.75in,
    footskip=0.6in,
    headsep=0.3in,
    %bindingoffset=0.2in,
     % showframe % Uncomment to display margin frames for debugging.
}


\addtolength{\textheight}{-5pt} % Decrease text height slightly.
\setlength{\headheight}{5pt} % Set header height.

\setlength{\parskip}{12pt}

\setlength{\textfloatsep}{24pt plus 4pt minus 2pt}   % increase space above/below top/bottom floats
\setlength{\floatsep}{18pt plus 3pt minus 1pt}       % increase space between multiple floats
\setlength{\intextsep}{24pt plus 4pt minus 2pt}      % increase space for inline floats