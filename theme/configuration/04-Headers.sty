\usepackage[bottom]{footmisc}
\usepackage{fancyhdr}
\usepackage{xcolor}

%%% --- Redefine footnote formatting for aligned number box --- %%%
\makeatletter
\renewcommand\@makefntext[1]{%
  \setlength{\hangindent}{2em}%
  \noindent
  \makebox[2em][r]{\@thefnmark.}~#1%
}
\makeatother

%%% --- Custom Footer with White Page Number --- %%%
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{%
  \raisebox{-13pt}{%
    \makebox[0pt][c]{\color{ndsu}\fontsize{11}{5}\selectfont \thepage}%
  }%
}

\renewcommand{\headrulewidth}{0pt}
