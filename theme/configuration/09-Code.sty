%%% ====================================================================
%%% 09-Code.sty — ARPC Brief Code Highlighting (listings only)
%%% ====================================================================

%%% --------------------------------------------------------------------
%%% Packages
%%% --------------------------------------------------------------------
\RequirePackage{newfloat}   % provides \SetupFloatingEnvironment
\RequirePackage{caption}    % caption control for listings
\RequirePackage{xcolor}     % colors for syntax
\RequirePackage{listings}   % pure-LaTeX code listings

%%% --------------------------------------------------------------------
%%% Define the listing float type
%%% --------------------------------------------------------------------
%\SetupFloatingEnvironment{listing}{name=Listing,within=none}
%\captionsetup[listing]{position=above,skip=-6pt}

%%% --------------------------------------------------------------------
%%% Define environments for code blocks
%%% --------------------------------------------------------------------
\newenvironment{code}{\captionsetup{type=listing}}{}
\newenvironment{longlisting}{\bigskip\medskip\captionsetup{type=listing}}{}

%%% --------------------------------------------------------------------
%%% listings configuration
%%% --------------------------------------------------------------------
\lstdefinestyle{arpcstyle}{
  basicstyle=\ttfamily\footnotesize,
  numbers=left,
  numberstyle=\tiny\color{gray},
  frame=lines,
  rulecolor=\color{gray!50},
  framesep=2mm,
  tabsize=4,
  breaklines=true,
  breakatwhitespace=true,
  captionpos=t,
  showstringspaces=false,
  keywordstyle=\color{blue!70!black}\bfseries,
  commentstyle=\color{gray!70!black}\itshape,
  stringstyle=\color{orange!70!black}
}

\lstset{style=arpcstyle}

%%% --------------------------------------------------------------------
%%% End of file
