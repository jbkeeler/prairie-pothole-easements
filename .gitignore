# ── Data ──────────────────────────────────────────────
# Blanket-ignore anything else dropped directly in data/, and catch stray
# data files anywhere in the repo (belt-and-suspenders with the dirs above).
data/*
!data/.gitkeep
*.parquet
*.rds
*.rda
*.RData
*.feather
*.arrow
*.fst
*.dta
*.sas7bdat
*.sav
# Uncomment to keep a specific small dataset in git:
# !data/keep_this_file.parquet

# ── Outputs (regenerated by scripts) ─────────────────────
output/
figures/*
!figures/.gitkeep
# !figures/main_figure.png
tables/*
!tables/.gitkeep
# !tables/main_table.csv

# ── R ─────────────────────────────────────────────────
.Rhistory
.RData
.RDataTmp
.Rproj.user/
.Ruserdata
*.Rout
.Rapp.history
# .Rproj is tracked on purpose so a fresh copy opens with the right settings

# R Markdown / Quarto build intermediates
*_cache/
*_files/
*.knit.md
*.utf8.md
.quarto/

# OAuth tokens or credentials (never commit these!)
.httr-oauth
.Renviron
.env
.env.local

# Package development temporary files (if building an R package)
/*-Ex.R
/*.tar.gz
/*.Rcheck/
src/*.o
src/*.so
src/*.dll
src/symbols.rds
revdep/

# ── LaTeX ─────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb
*_minted-*/

# ── OS junk ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────
.vscode/
*.code-workspace
*.swp
*~

# ── Archive ───────────────────────────────────────────
archive/
